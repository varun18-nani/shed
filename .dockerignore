.env
.env.*
!.env.example

# ── Development tooling ───────────────────────────────────
.windsurf
.claude
.agents
.gemini
*.tsbuildinfo

# ── Coverage / logs ───────────────────────────────────────
coverage
logs
*.log

# ── OS artefacts ─────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor / IDE ──────────────────────────────────────────
.vscode
.idea

# ── Temporary / local-only scripts ───────────────────────
